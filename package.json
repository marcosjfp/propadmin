{
  "name": "administrador-de-propriedades",
  "version": "1.0.0",
  "description": "Aplicação de gerenciamento de propriedades",
  "main": "server/_core/index.ts",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm exec tsx watch server/_core/index.ts",
    "start": "node --import tsx server/_core/index.ts",
    "build": "node scripts/build.mjs",
    "client-dev": "pnpm --dir client dev",
    "client-build": "pnpm --dir client build",
    "type-check": "tsc --noEmit",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:seed-local-admin": "node --env-file=.env.test.local --import tsx scripts/seed-local-admin.ts",
    "dev:local": "node --env-file=.env.test.local --import tsx server/_core/index.ts",
    "production:check": "node --import tsx scripts/production-check.ts",
    "test:integration": "node --env-file=.env.test.local scripts/test-integration.mjs",
    "db:migrate-images": "node --import tsx scripts/migrate-images.ts",
    "storage:cleanup": "node --import tsx scripts/cleanup-storage.ts",
    "server:check": "node scripts/check-server.mjs"
  },
  "keywords": [
    "propriedades",
    "gerenciamento",
    "imobiliário"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@trpc/server": "^10.45.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vercel/functions": "3.10.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.23.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "superjson": "^2.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "8.23.1"
  },
  "packageManager": "pnpm@11.1.3"
}
