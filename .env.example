# ===========================================
# Variáveis de Ambiente - Administrador de Propriedades
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Banco de Dados PostgreSQL (Supabase)
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_database

# Ambiente (development ou production)
NODE_ENV=development

# Porta do servidor
PORT=3000

# Chave secreta para JWT - OBRIGATÓRIO
# Gere com: openssl rand -hex 32
# ATENÇÃO: Nunca use o valor padrão em produção!
JWT_SECRET=troque-este-valor-por-uma-chave-segura-de-64-caracteres-gerada-com-openssl

# ===========================================
# Variáveis para Deploy em Produção (Vercel)
# ===========================================
# DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=verify-full

# URL base da aplicação (para CORS)
# CLIENT_URL=https://seu-dominio.vercel.app


# Development authentication bypass is disabled by default.
# ENABLE_DEV_LOGIN=true

# For an isolated local admin, use .env.test.local and docker-compose.local.yml.
# See LOCAL_TEST_ADMIN.md for setup; do not seed the remote database.

# Private Supabase Storage (required in production; keep service key server-only)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=property-images

# Local development stores verified images here; never use this on Vercel.
# LOCAL_STORAGE_PATH=/absolute/path/to/local-images

# Set to the exact number of trusted reverse proxies (Vercel defaults to 1).
# Direct localhost access defaults to 0.
# TRUST_PROXY_HOPS=1
